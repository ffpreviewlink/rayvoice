# Public origin of the site (canonical URLs, Open Graph, sitemap).
SITE_URL=https://www.thatsraysvoice.com

# Contact form backend. Any service that accepts a multipart POST and answers with JSON
# works (Formspree, Basin, Getform, a Cloudflare Worker, ...).
# When empty, the form falls back to opening the visitor's email client (mailto:).
PUBLIC_FORM_ENDPOINT=
