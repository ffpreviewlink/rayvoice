---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { isPreview, site } from '../data/site';
import { stripBase, url } from '../utils/url';
import '../styles/global.css';

interface Props {
  /** Page title. Combined with the site name unless `fullTitle` is set. */
  title: string;
  description?: string;
  fullTitle?: boolean;
  /** Colour of the last section, so the footer seam matches. */
  footerFrom?: string;
  noindex?: boolean;
  /** Social image path inside public/ (defaults to the shared 1200x630 card). */
  image?: string;
  imageAlt?: string;
}
const { title, description = site.description, fullTitle = false, footerFrom, noindex = false, image = site.ogImage.path, imageAlt = site.ogImage.alt } = Astro.props;

const pageTitle = fullTitle ? title : `${title} | ${site.name}`;
// Canonical = site origin + base + this page's own route (never the homepage for every page).
// The root keeps its trailing slash ('/rayvoice/'), other routes have none ('/rayvoice/showreels').
const route = stripBase(Astro.url.pathname).replace(/(.)\/$/, '$1');
const canonical = new URL(url(route), Astro.site);
const preview = isPreview(Astro.site);
// Absolute https URL of the social image, built from `site` + `base` (never a bare '/images/...').
const ogUrl = new URL(url(image), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Raymundo Rodrigues',
  alternateName: site.person,
  jobTitle: 'Voice actor',
  url: new URL(url('/'), Astro.site).href,
  email: site.email,
  knowsLanguage: ['en-US', 'en-GB', 'it', 'bg'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f6f4ed" />

    <!-- Icons built from the original character artwork. Regenerate with `npm run favicons`. -->
    <link rel="icon" href={url('/favicon-32x32.png')} type="image/png" sizes="32x32" />
    <link rel="icon" href={url('/favicon-16x16.png')} type="image/png" sizes="16x16" />
    <link rel="icon" href={url('/favicon.ico')} sizes="48x48" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} sizes="180x180" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:type" content={site.ogImage.type} />
    <meta property="og:image:width" content={String(site.ogImage.width)} />
    <meta property="og:image:height" content={String(site.ogImage.height)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <Font cssVariable="--font-display" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin', style: 'normal' }]} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to Content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer from={footerFrom} />

    <script>
      // Scroll reveal: purely progressive; content is visible if this never runs.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && targets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => observer.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
