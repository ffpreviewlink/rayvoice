---
/**
 * Section seam: a fine coral line shaped like a voice envelope, with the next section's
 * colour filled beneath it. Purely decorative (aria-hidden).
 *  - to:   colour of the section that follows (fills below the line)
 *  - from: colour of the section above (the SVG background)
 */
interface Props {
  from: string;
  to: string;
}
const { from, to } = Astro.props;

// Deterministic "speech envelope": a few summed sines, sampled across the viewBox.
const W = 1440;
const H = 64;
const points: string[] = [];
for (let x = 0; x <= W; x += 20) {
  const t = x / W;
  const env = 0.55 + 0.45 * Math.sin(t * Math.PI * 2.2 + 0.6);
  const y = H * 0.55 + Math.sin(t * 38) * 4 * env + Math.sin(t * 11 + 1.3) * 9 * env + Math.sin(t * 5) * 6;
  points.push(`${x},${y.toFixed(1)}`);
}
const line = `M${points.join(' L')}`;
const area = `${line} L${W},${H} L0,${H} Z`;
---

<div class="wave" style={`--from:${from};--to:${to}`} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" focusable="false">
    <path d={area} class="wave__fill"></path>
    <path d={line} class="wave__line" vector-effect="non-scaling-stroke"></path>
  </svg>
</div>

<style>
  .wave {
    background: var(--from);
    line-height: 0;
    margin-block: -1px;
  }
  .wave svg {
    display: block;
    width: 100%;
    height: clamp(2.25rem, 1.5rem + 3vw, 4rem);
  }
  .wave__fill {
    fill: var(--to);
  }
  .wave__line {
    fill: none;
    stroke: var(--coral-500);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
</style>
