---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import emil from '../assets/images/avatar-emil.webp';
import konstantin from '../assets/images/avatar-konstantin.webp';
import max from '../assets/images/avatar-max.webp';

/** Verbatim from the original testimonial cards (including the clients' own wording). */
const quotes = [
  {
    avatar: emil,
    name: 'Emil',
    role: 'CEO AVO Pictures Studio',
    text: 'Thank you to Ray for the excellent work on our joint projects! He always completes the tasks precisely, quickly, and on time. Working with him is easy and pleasant – he understands the requirements in detail and implements them flawlessly. I recommend him with full confidence!',
  },
  {
    avatar: max,
    name: 'Max',
    role: 'Model & Head of Creative',
    text: 'Ray is a true professional. Collaborating with him was such a pleasant experience! His work ethic is like no other’s I’d ever seen, his line delivery was great, he kept the mood up for the whole project, and with his talent brought the production to life. I highly recommend him and will be returning for future projects!',
  },
  {
    avatar: konstantin,
    name: 'Konstantin',
    role: 'CEO & Creative Director elestyCreative',
    text: 'Ray is the breath behind elesty’s mission, vision and values. John 1:1: “In the beginning was the Word, and the Word was with God, and the Word was God.” No breath, no words, no God. A strong message was not enough, what we were missing was the voice to speak it, Ray saved us from from floating away in the darkcold abyss of marketing seen and heard by nobody.',
  },
];
---

<section class="testimonials on-mist" aria-labelledby="testimonials-title">
  <div class="container testimonials__grid">
    <h2 id="testimonials-title" class="testimonials__title">Read what my clients say about working with me<span class="colon">:</span></h2>

    <div class="testimonials__list">
      {
        quotes.map((quote, i) => (
          <figure class="quote" data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <div class="quote__stars" role="img" aria-label="Rated 5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} />)}
            </div>
            <blockquote class="quote__text">
              <p>{quote.text}</p>
            </blockquote>
            <figcaption class="quote__by">
              <Image src={quote.avatar} alt="" width={96} height={96} class="quote__avatar" />
              <span class="quote__who">
                <span class="quote__name">{quote.name}</span>
                <span class="quote__role">{quote.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials {
    padding-block: var(--space-section);
  }
  .testimonials__grid {
    display: grid;
    gap: var(--space-l);
  }
  .testimonials__title {
    font-size: var(--fs-h2);
    max-width: 14ch;
  }
  .testimonials__list {
    display: grid;
  }
  .quote {
    margin: 0;
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-l);
    border-top: 1px solid var(--line-strong);
  }
  .quote:last-child {
    border-bottom: 1px solid var(--line-strong);
  }
  .quote__stars {
    display: flex;
    gap: 0.2rem;
    color: var(--coral-600);
  }
  .quote__text {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-quote);
    line-height: 1.25;
    text-wrap: pretty;
  }
  .quote__by {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: var(--space-2xs);
  }
  .quote :global(.quote__avatar) {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    object-fit: cover;
    flex: none;
    box-shadow: 0 0 0 2px var(--surface), 0 0 0 3.5px var(--navy-900);
  }
  .quote__who {
    display: grid;
    line-height: 1.3;
  }
  .quote__name {
    font-weight: 650;
  }
  .quote__role {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  @media (min-width: 64em) {
    .testimonials__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 0.4rem + 2vw, 2rem);
      align-items: start;
    }
    .testimonials__title {
      grid-column: 1 / span 4;
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
    }
    .testimonials__list {
      grid-column: 6 / -1;
    }
    .quote {
      padding-block: var(--space-xl) var(--space-l);
    }
    .quote:first-child {
      padding-top: var(--space-l);
      border-top: 0;
    }
  }
</style>
