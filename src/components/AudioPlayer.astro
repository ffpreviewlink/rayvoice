---
import Icon from './Icon.astro';
/**
 * Accessible audio player. Real <audio> element + custom controls:
 * play/pause, seek slider, elapsed / duration, download. Without JavaScript the browser's
 * native controls are shown instead, so playback never depends on the enhancement.
 */
interface Props {
  /** Visible title. */
  name: string;
  /** Tone descriptor under the title. */
  tone?: string;
  /** Language label shown as metadata. */
  language?: string;
  src: string;
  durationMs: number;
  /** Full accessible name when it differs from `name` (e.g. includes the language). */
  accessibleName?: string;
  /** Single-row layout for dense lists (audiobooks). */
  compact?: boolean;
  /** Number shown before the title, e.g. "01". */
  index?: string;
}
const { name, tone, language, src, durationMs, accessibleName, compact = false, index } = Astro.props;
const fullName = accessibleName ?? (language ? `${name} (${language})` : name);
const total = Math.round(durationMs / 1000);
const mmss = `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
---

<div class:list={['player', { 'player--compact': compact }]} data-player data-state="idle" data-name={fullName} data-duration={total}>
  <!-- Native fallback, hidden once the script has enhanced the player -->
  <audio class="player__audio" preload="none" controls src={src} aria-label={fullName}></audio>

  <div class="player__ui">
    <button type="button" class="player__toggle" data-toggle aria-label={`Play ${fullName}`}>
      <Icon name="play" size={22} />
      <Icon name="pause" size={22} />
    </button>

    <div class="player__info">
      {index && <span class="player__index" aria-hidden="true">{index}</span>}
      <p class="player__title">{name}</p>
      {(tone || language) && (
        <p class="player__meta">
          {tone && <span>{tone}</span>}
          {tone && language && <span class="player__sep" aria-hidden="true">·</span>}
          {language && <span>{language}</span>}
        </p>
      )}
    </div>

    <div class="player__actions">
      <span class="player__time" data-time><span data-elapsed>0:00</span><span class="player__slash" aria-hidden="true"> / </span><span class="sr-only"> of </span><span data-total>{mmss}</span></span>
      <a class="player__download" href={src} download target="_blank" rel="noopener" aria-label={`Download ${fullName}`}>
        <Icon name="download" size={18} />
        <span class="player__download-text">Download</span>
      </a>
    </div>

    <input
      class="player__seek"
      type="range"
      min="0"
      max={total}
      step="0.1"
      value="0"
      data-seek
      aria-label={`Seek ${fullName}`}
      aria-valuetext={`0:00 of ${mmss}`}
    />
    <p class="player__status" data-status role="status" hidden>This recording couldn’t be loaded. Please try again, or request it by email.</p>
  </div>
</div>

<style>
  .player {
    --row-bg: var(--surface-raised);
    --track: color-mix(in srgb, var(--text) 22%, transparent);
    position: relative;
    container-type: inline-size;
    height: 100%;
    background: var(--row-bg);
    border: var(--border);
    border-radius: var(--radius-s);
    color: var(--text);
    transition:
      background-color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .player:hover,
  .player:focus-within {
    border-color: var(--line-strong);
  }
  .player[data-state='playing'] {
    border-color: var(--accent);
  }

  /* Native fallback vs enhanced UI */
  .player__audio {
    display: block;
    width: 100%;
    height: 3.25rem;
  }
  .player.is-enhanced .player__audio {
    display: none;
  }
  .player__ui {
    display: none;
  }
  .player.is-enhanced .player__ui {
    display: grid;
    height: 100%;
  }
  .player__ui {
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: 1fr auto;
    grid-template-areas:
      'toggle info info'
      'seek seek actions';
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.1rem;
    padding: 0.85rem 0.75rem 0.4rem 0.85rem;
  }
  /* Roomier containers: the seek bar tucks under the title, actions sit top-right. */
  @container (min-width: 30rem) {
    .player__ui {
      grid-template-areas:
        'toggle info actions'
        'toggle seek seek';
      padding: 0.85rem 1rem 0.5rem 0.85rem;
    }
    .player__actions {
      align-self: start;
    }
  }

  .player__toggle {
    grid-area: toggle;
    position: relative;
    width: 3.25rem;
    height: 3.25rem;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--text);
    border-radius: var(--radius-full);
    background: transparent;
    color: var(--text);
    transition:
      background-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease);
  }
  .player__toggle :global(.icon) {
    grid-area: 1 / 1;
  }
  .player__toggle :global(.icon--play) {
    transform: translateX(1px);
  }
  .player__toggle :global(.icon--pause) {
    display: none;
  }
  .player__toggle:hover {
    background: var(--coral-500);
    border-color: var(--coral-500);
    color: var(--navy-900);
  }
  .player__toggle:active {
    transform: scale(0.96);
  }
  .player[data-state='playing'] .player__toggle,
  .player[data-state='loading'] .player__toggle {
    background: var(--coral-500);
    border-color: var(--coral-500);
    color: var(--navy-900);
  }
  .player[data-state='playing'] .player__toggle :global(.icon--play),
  .player[data-state='loading'] .player__toggle :global(.icon--play) {
    display: none;
  }
  .player[data-state='playing'] .player__toggle :global(.icon--pause),
  .player[data-state='loading'] .player__toggle :global(.icon--pause) {
    display: block;
  }
  .player[data-state='loading'] .player__toggle {
    animation: pulse 1s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.6;
    }
  }

  .player__info {
    grid-area: info;
    min-width: 0;
    display: grid;
    gap: 0.1rem;
  }
  .player__index {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--accent-text);
    line-height: 1;
  }
  .player__title {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .player__meta {
    font-size: var(--fs-small);
    color: var(--text-muted);
    line-height: 1.35;
  }
  .player__sep {
    margin-inline: 0.4em;
  }

  .player__actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    justify-self: end;
  }
  .player__time {
    font-size: var(--fs-small);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .player__download {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    color: var(--text);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    border-radius: var(--radius-s);
  }
  .player__download:hover {
    color: var(--accent-text);
  }
  .player__download-text {
    display: none;
  }
  @container (min-width: 30rem) {
    .player:not(.player--compact) .player__download-text {
      display: inline;
    }
  }

  /* Seek slider: a segmented track, filled in coral up to the playhead. */
  .player__seek {
    grid-area: seek;
    --p: 0%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 1.75rem;
    margin: 0;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius-s);
  }
  .player__seek::-webkit-slider-runnable-track {
    height: 0.5rem;
    border-radius: 1px;
    background:
      repeating-linear-gradient(90deg, transparent 0 3px, var(--row-bg) 3px 4px),
      linear-gradient(90deg, var(--coral-500) var(--p), var(--track) var(--p));
  }
  .player__seek::-moz-range-track {
    height: 0.5rem;
    border-radius: 1px;
    background:
      repeating-linear-gradient(90deg, transparent 0 3px, var(--row-bg) 3px 4px),
      linear-gradient(90deg, var(--coral-500) var(--p), var(--track) var(--p));
  }
  .player__seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 0.375rem;
    height: 1.25rem;
    margin-top: -0.375rem;
    border: 0;
    border-radius: 1px;
    background: var(--text);
  }
  .player__seek::-moz-range-thumb {
    width: 0.375rem;
    height: 1.25rem;
    border: 0;
    border-radius: 1px;
    background: var(--text);
  }
  .player__seek:focus-visible {
    outline-offset: 2px;
  }

  .player__status {
    grid-column: 1 / -1;
    font-size: var(--fs-small);
    color: var(--accent-text);
    padding-block: 0.25rem 0.5rem;
  }

  /* Compact variant: tighter, smaller title */
  .player--compact .player__ui {
    padding: 0.7rem 0.85rem 0.4rem 0.7rem;
    column-gap: 0.85rem;
  }
  .player--compact .player__toggle {
    width: 2.875rem;
    height: 2.875rem;
  }
  .player--compact .player__title {
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
  }
</style>

<script>
  const fmt = (s: number) => {
    if (!Number.isFinite(s) || s < 0) s = 0;
    return `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
  };

  const players = document.querySelectorAll<HTMLElement>('[data-player]');

  // Only one recording plays at a time (audio and video alike).
  document.addEventListener(
    'play',
    (event) => {
      document.querySelectorAll<HTMLMediaElement>('audio, video').forEach((media) => {
        if (media !== event.target && !media.paused) media.pause();
      });
    },
    true,
  );

  players.forEach((root) => {
    const audio = root.querySelector<HTMLAudioElement>('audio')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const seek = root.querySelector<HTMLInputElement>('[data-seek]')!;
    const elapsed = root.querySelector<HTMLElement>('[data-elapsed]')!;
    const total = root.querySelector<HTMLElement>('[data-total]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const name = root.dataset.name ?? 'recording';

    // Enhance: swap native controls for the custom UI.
    audio.removeAttribute('controls');
    root.classList.add('is-enhanced');

    let pendingSeek: number | null = null;
    const duration = () => (Number.isFinite(audio.duration) && audio.duration > 0 ? audio.duration : Number(root.dataset.duration) || 0);

    const render = () => {
      const d = duration();
      const t = audio.currentTime;
      seek.max = String(d);
      seek.value = String(t);
      seek.style.setProperty('--p', `${d ? Math.min(100, (t / d) * 100) : 0}%`);
      elapsed.textContent = fmt(t);
      total.textContent = fmt(d);
      seek.setAttribute('aria-valuetext', `${fmt(t)} of ${fmt(d)}`);
    };

    const setState = (state: 'idle' | 'loading' | 'playing' | 'paused' | 'error') => {
      root.dataset.state = state;
      toggle.setAttribute('aria-label', `${state === 'playing' || state === 'loading' ? 'Pause' : 'Play'} ${name}`);
      status.hidden = state !== 'error';
    };

    toggle.addEventListener('click', () => {
      if (audio.paused) {
        setState('loading');
        audio.play().catch(() => {
          if (root.dataset.state === 'loading') setState('error');
        });
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('playing', () => setState('playing'));
    audio.addEventListener('waiting', () => !audio.paused && setState('loading'));
    audio.addEventListener('pause', () => setState(audio.ended ? 'idle' : 'paused'));
    audio.addEventListener('ended', () => {
      audio.currentTime = 0;
      setState('idle');
      render();
    });
    audio.addEventListener('error', () => setState('error'));
    audio.addEventListener('timeupdate', render);
    audio.addEventListener('durationchange', render);
    audio.addEventListener('loadedmetadata', () => {
      if (pendingSeek !== null) {
        audio.currentTime = pendingSeek;
        pendingSeek = null;
      }
      render();
    });

    seek.addEventListener('input', () => {
      const t = Number(seek.value);
      if (audio.readyState === 0) {
        // Metadata not loaded yet (preload="none"): remember the target and start loading.
        pendingSeek = t;
        audio.preload = 'metadata';
        audio.load();
        seek.style.setProperty('--p', `${(t / (duration() || 1)) * 100}%`);
        elapsed.textContent = fmt(t);
      } else {
        audio.currentTime = t;
      }
    });
  });
</script>
