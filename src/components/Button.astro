---
import { url } from '../utils/url';
import Icon from './Icon.astro';

/**
 * Link or button with one of three visual variants.
 *  - primary:   coral fill, the main call to action
 *  - secondary: outlined, follows the surrounding text colour
 *  - text:      underlined link with an arrow
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  size?: 'm' | 'l';
  icon?: 'arrow-right' | 'download' | 'mail';
  type?: 'button' | 'submit';
  external?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { href, variant = 'primary', size = 'm', icon, type = 'button', external = false, class: className = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
// Internal paths ('/contacts') get the site base; external URLs, mailto: and #anchors pass through untouched.
const resolved = href?.startsWith('/') && !href.startsWith('//') ? url(href) : href;
const attrs = href ? { href: resolved, ...(external ? { target: '_blank', rel: 'noopener' } : {}) } : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...attrs} {...rest}>
  <span class:list={['btn__label', { 'u-draw': variant === 'text' }]}><slot /></span>
  {icon && <Icon name={icon} size={18} />}
</Tag>

<style>
  .btn {
    --btn-bg: var(--coral-500);
    --btn-fg: var(--navy-900);
    /* colours the hover fill sweeps in with */
    --btn-wipe: var(--navy-900);
    --btn-wipe-fg: var(--ivory-50);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3rem;
    padding: 0.7rem 1.4rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-s);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 650;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    max-width: 100%;
    background: var(--btn-bg);
    color: var(--btn-fg);
    transition:
      color 200ms var(--ease),
      border-color 320ms var(--ease),
      transform var(--dur-fast) var(--ease),
      box-shadow 320ms var(--ease);
  }
  .btn--l {
    min-height: 3.5rem;
    padding: 0.85rem 1.75rem;
    font-size: 1.0625rem;
  }
  .btn__label {
    text-wrap: balance;
  }
  .btn :global(.icon) {
    flex: none;
    transition: transform 320ms var(--ease);
  }

  /* Fill that sweeps in from the left on hover and leaves to the right */
  .btn::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--btn-wipe);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 460ms var(--ease);
  }
  .btn--primary:active,
  .btn--secondary:active {
    transform: translateY(1px);
  }

  /* On dark surfaces the primary wipes to ivory instead of navy */
  :global(.on-dark) .btn--primary {
    --btn-wipe: var(--ivory-100);
    --btn-wipe-fg: var(--navy-900);
  }

  .btn--secondary {
    --btn-bg: transparent;
    --btn-fg: var(--text);
    --btn-wipe: var(--text);
    --btn-wipe-fg: var(--surface);
    border-color: var(--line-strong);
  }
  /* Secondary fills from the bottom */
  .btn--secondary::before {
    transform: scaleY(0);
    transform-origin: bottom;
  }

  /* Text link: underline redraw lives in utilities.css (.u-draw) */
  .btn--text {
    --btn-bg: transparent;
    --btn-fg: var(--text);
    min-height: 2.75rem;
    padding: 0.4rem 0.15rem;
    border: 0;
    border-radius: 0;
    justify-content: flex-start;
    overflow: visible;
  }
  .btn--text::before {
    display: none;
  }

  @media (hover: hover) {
    .btn:hover {
      color: var(--btn-wipe-fg);
      /* the label flips colour once the fill has passed under it */
      transition-duration: 160ms, 320ms, var(--dur-fast), 320ms;
      transition-delay: 150ms, 0s, 0s, 0s;
    }
    .btn:hover::before {
      transform: scale(1);
      transform-origin: left;
    }
    .btn--secondary:hover {
      border-color: var(--btn-wipe);
    }
    .btn--secondary:hover::before {
      transform-origin: bottom;
    }
    .btn--text:hover {
      color: var(--btn-fg);
    }
    .btn--primary:hover {
      box-shadow: 0 10px 24px -12px rgb(11 16 34 / 0.55);
    }
    .btn:hover :global(.icon--arrow-right) {
      transform: translateX(5px);
    }
    .btn:hover :global(.icon--download) {
      transform: translateY(3px);
    }
    .btn:hover :global(.icon--mail) {
      transform: rotate(-8deg) scale(1.1);
    }
  }
</style>
