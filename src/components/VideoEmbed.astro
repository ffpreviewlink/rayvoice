---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

/**
 * Click-to-load video. Nothing is downloaded until the visitor presses play:
 * the poster is a local image and the HLS stream is attached on demand
 * (native on Safari, hls.js elsewhere, loaded lazily).
 */
interface Props {
  playlist: string;
  poster: ImageMetadata;
  durationSeconds: number;
  /** Accessible name, e.g. "Domino’s Bulgaria video 1". */
  label: string;
}
const { playlist, poster, durationSeconds, label } = Astro.props;
const total = Math.floor(durationSeconds);
const mmss = `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
---

<figure class="video" data-video data-playlist={playlist} data-label={label}>
  <div class="video__frame">
    <Image src={poster} alt="" width={960} height={540} widths={[480, 720, 960]} sizes="(min-width: 64em) 26rem, (min-width: 40em) 45vw, 92vw" loading="lazy" class="video__poster" />
    <button type="button" class="video__play" data-play aria-label={`Play ${label}, ${mmss}`}>
      <span class="video__icon"><Icon name="play" size={26} /></span>
      <span class="video__time" aria-hidden="true">{mmss}</span>
    </button>
    <p class="video__error" data-error role="status" hidden>This video couldn’t be loaded. Please try again later.</p>
  </div>
</figure>

<style>
  .video {
    margin: 0;
  }
  .video__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--navy-950);
    overflow: hidden;
    border-radius: var(--radius-s);
  }
  .video__frame :global(.video__poster),
  .video__frame :global(video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .video__frame :global(video) {
    background: #000;
    object-fit: contain;
  }
  .video__frame :global(.video__poster) {
    transition: transform 900ms var(--ease);
  }
  .video__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(11 16 34 / 0.55), transparent 55%);
    pointer-events: none;
  }
  .video:hover :global(.video__poster) {
    transform: scale(1.03);
  }
  .video__play {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--ivory-50);
  }
  .video__icon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-full);
    background: var(--coral-500);
    color: var(--navy-900);
    box-shadow: var(--shadow-m);
    transition:
      transform var(--dur) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .video__icon :global(.icon) {
    transform: translateX(2px);
  }
  .video__play:hover .video__icon {
    transform: scale(1.08);
    background: var(--coral-400);
  }
  .video__play[hidden],
  .video__error[hidden] {
    display: none;
  }
  .video.is-loaded .video__frame::after {
    display: none;
  }
  .video__time {
    position: absolute;
    left: 0.9rem;
    bottom: 0.7rem;
    font-size: var(--fs-small);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    text-shadow: 0 1px 6px rgb(0 0 0 / 0.6);
  }
  .video__error {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--navy-950);
    color: var(--ivory-50);
    font-size: var(--fs-small);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const frame = root.querySelector<HTMLElement>('.video__frame')!;
    const error = root.querySelector<HTMLElement>('[data-error]')!;
    const playlist = root.dataset.playlist!;
    const label = root.dataset.label ?? 'Video';

    button.addEventListener('click', async () => {
      button.disabled = true;
      error.hidden = true;

      const video = document.createElement('video');
      video.controls = true;
      video.playsInline = true;
      video.preload = 'auto';
      video.setAttribute('aria-label', label);

      const fail = () => {
        video.remove();
        root.classList.remove('is-loaded');
        button.hidden = false;
        button.disabled = false;
        error.hidden = false;
      };

      try {
        if (video.canPlayType('application/vnd.apple.mpegurl')) {
          // Safari / iOS play HLS natively.
          video.src = playlist;
        } else {
          const { default: Hls } = await import('hls.js');
          if (!Hls.isSupported()) throw new Error('HLS unsupported');
          const hls = new Hls();
          hls.loadSource(playlist);
          hls.attachMedia(video);
          hls.on(Hls.Events.ERROR, (_event, data) => {
            if (data.fatal) {
              hls.destroy();
              fail();
            }
          });
        }
        frame.append(video);
        root.classList.add('is-loaded');
        button.hidden = true;
        await video.play();
        video.focus();
      } catch {
        // play() can be rejected without being fatal (e.g. autoplay policy): keep the controls visible.
        if (!video.isConnected) fail();
      }
    });
  });
</script>
