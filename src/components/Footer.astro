---
import { nav, site } from '../data/site';
import { url } from '../utils/url';
import Button from './Button.astro';
import WaveDivider from './WaveDivider.astro';

interface Props {
  /** Background colour of the section directly above the footer (for the seam). */
  from?: string;
}
const { from = 'var(--ivory-100)' } = Astro.props;
const year = new Date().getFullYear();
---

<WaveDivider from={from} to="var(--navy-900)" />
<footer class="footer on-dark">
  <div class="footer__main container">
    <div class="footer__lead">
      <h2 class="footer__title"><span>{site.tagline}</span></h2>
      <div class="footer__copy">
        <p>Trusted by media agencies, production houses, and creative teams worldwide.</p>
        <p>Industry-standard quality, lightning-fast turnaround, and a seamless workflow that fits your pipeline.</p>
        <p>Need a voiceover artist who understands your production needs? Let’s talk.</p>
      </div>
    </div>

    <div class="footer__side">
      <p class="label footer__spec">Source Connect Standard | Broadcast-Ready Quality</p>
      <div class="footer__ctas">
        <Button href="/contacts" size="l">Get a quote</Button>
        <Button href="/contacts" size="l" variant="secondary">Contact me</Button>
      </div>
      <nav aria-label="Footer">
        <ul class="footer__nav">
          {nav.map((item) => <li><a href={url(item.href)}>{item.label}</a></li>)}
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </nav>
    </div>
  </div>
  <div class="footer__bar container">
    <p>© {year} {site.name}</p>
    <p class="footer__credit">
      <a href="https://federicofuffa.it" target="_blank" rel="noopener">
        Website by Federico Fuffa
        <svg class="footer__arrow" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2.5 7.5l5-5M3.5 2.5h4v4" /></svg>
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-l);
  }
  .footer__main {
    display: grid;
    gap: var(--space-l);
    padding-bottom: var(--space-l);
  }
  .footer__title {
    font-size: var(--fs-h2);
    line-height: 1.02;
    max-width: 14ch;
    margin-bottom: var(--space-m);
  }
  .footer__title span {
    text-decoration: underline;
    text-decoration-color: var(--coral-500);
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.12em;
  }
  .footer__copy {
    display: grid;
    gap: 0.5rem;
    max-width: 36rem;
    color: var(--text-muted);
  }
  .footer__side {
    display: grid;
    align-content: start;
    gap: var(--space-m);
  }
  .footer__spec {
    color: var(--ivory-100);
  }
  .footer__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
  }
  .footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text);
    text-decoration-color: var(--line-strong);
  }
  .footer__nav a {
    transition:
      color var(--dur-fast) var(--ease),
      text-decoration-color var(--dur-fast) var(--ease);
  }
  .footer__nav a:hover {
    color: var(--coral-500);
    text-decoration-color: var(--coral-500);
  }
  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1.5rem;
    padding-block: 0.5rem 1.25rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .footer__credit a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
  }
  .footer__credit a:hover {
    color: var(--text);
  }
  .footer__arrow {
    flex: none;
    transition: transform var(--dur) var(--ease);
  }
  .footer__credit a:hover .footer__arrow {
    transform: translate(1px, -1px);
  }

  @media (min-width: 64em) {
    .footer__main {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: end;
      column-gap: var(--space-xl);
    }
    .footer__side {
      justify-self: end;
      width: min(100%, 28rem);
    }
  }
</style>
