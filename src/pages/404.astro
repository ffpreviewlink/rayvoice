---
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex footerFrom="var(--ivory-100)">
  <section class="lost">
    <div class="container lost__inner">
      <p class="label">404</p>
      <h1 class="lost__title">This page <span class="accent">lost its voice.</span></h1>
      <p class="lead">The page you’re looking for doesn’t exist or has moved. Let’s get you back to the good stuff.</p>
      <div class="lost__actions">
        <Button href="/" size="l" icon="arrow-right">Back to Home</Button>
        <Button href="/showreels" size="l" variant="secondary">Listen to the showreels</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    padding-block: var(--space-section);
  }
  .lost__inner {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  .lost__title {
    font-size: var(--fs-display);
    line-height: var(--lh-tight);
    max-width: 11ch;
  }
  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
